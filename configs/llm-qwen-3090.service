[Unit]
Description=Qwen3.6-35B-A3B on the 3090 alone (configs/qwen36-3090-serve.sh); the A6000 stays free
After=network-online.target thermal-guard.service
Wants=network-online.target
Conflicts=llm.service llm-3090.service

[Service]
Type=simple
User=user
ExecStart=/home/user/qwen36-3090-serve.sh
Restart=on-failure
RestartSec=30
SuccessExitStatus=143 SIGTERM
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
