# Which card is CUDA0 — by UUID, never by slot.
#
# Since 2026-11-16 the machine holds one card, an RTX 5090 (the A6000 and the 3090 left for
# sale; docs/machine-changes.md). With one card the order cannot be wrong, but the UUID still
# keeps a launcher off whatever card comes next.
#
# CUDA enumerates the devices in CUDA_VISIBLE_DEVICES in list order, and accepts UUIDs, so
# this one line fixes the index for llama.cpp, ik_llama.cpp, exllamav3 and torch alike.
# Source it before launching anything that names a CUDA index.
# nvidia-smi does NOT honour CUDA_VISIBLE_DEVICES: address it with -i $RTX5090_UUID.
export RTX5090_UUID=GPU-89c55c8d-7c4a-f866-4e18-ad94911fc9aa
export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-$RTX5090_UUID}
unset CUDA_DEVICE_ORDER
