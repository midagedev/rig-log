# Which card is CUDA0 — by UUID, never by slot.
#
# 2026-09-16: the A6000 moved from bus 01 to bus 61 to fix a Gen4 margin problem
# (log/2026-09-16-the-overclock-and-the-fabric.md). Under CUDA_DEVICE_ORDER=PCI_BUS_ID
# that made the 3090 device 0, and every placement in this repo -- the -ot strings,
# -ts 2,1, exl3 -gs 44,21 -- assumes CUDA0 is the 48 GB card. A training launcher with
# CUDA_VISIBLE_DEVICES=0 put a 38 GB job on the 24 GB card and OOMed at step 52000.
#
# CUDA enumerates the devices in CUDA_VISIBLE_DEVICES in list order, and accepts
# UUIDs, so this one line fixes the index for llama.cpp, ik_llama.cpp, exllamav3 and
# torch alike. Source it before launching anything that names a CUDA index.
# nvidia-smi does NOT honour CUDA_VISIBLE_DEVICES: address it with -i $A6000_UUID.
export A6000_UUID=GPU-8c129fa6-7382-35a5-2464-9ff01d99fcd4
export GF3090_UUID=GPU-307fa0f6-daae-24e5-6fd3-cd50620de6b1
export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-$A6000_UUID,$GF3090_UUID}
unset CUDA_DEVICE_ORDER
